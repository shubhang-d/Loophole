<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Signature-level permission. It cannot be requested at runtime and must be
      granted over adb:
        adb shell pm grant com.shubhang.loophole android.permission.WRITE_SECURE_SETTINGS
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".LoopholeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Loophole">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Loophole">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Long-pressing the Quick Settings tile. SystemUI resolves this
              action against the tile's own package first and only falls back to
              the App Info screen when nothing handles it, so declaring it here
              sends the long-press into the app instead.
            -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.DevOptionsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".widget.ToggleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.shubhang.loophole.action.TOGGLE_DEV_MODE" />
                <action android:name="com.shubhang.loophole.action.TOGGLE_USB_DEBUG" />
                <action android:name="com.shubhang.loophole.action.TOGGLE_WIRELESS_DEBUG" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.DevModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_dev_mode_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.UsbDebugTileService"
            android:exported="true"
            android:icon="@drawable/ic_usb_tile"
            android:label="@string/tile_usb_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.WirelessDebugTileService"
            android:exported="true"
            android:icon="@drawable/ic_wireless_tile"
            android:label="@string/tile_wireless_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.LoopholeWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/loophole_widget_info" />
        </receiver>
    </application>

</manifest>
